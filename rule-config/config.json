{
    "waf_enable": "on",
    "trust_proxy_headers": "on",
    "log_dir": "/var/log/caddyguard",
    "white_url_check": "on",
    "white_ip_check": "on",
    "white_ua_check": "on",
    "black_ip_check": "on",
    "url_check": "on",
    "url_args_check": "on",
    "user_agent_check": "on",
    "cookie_check": "on",
    "cc_check": "on",
    "cc_rate": "150/60",
    "cc_block_ttl": 600,
    "post_check": "on",
    "referer_check": "off",
    "file_upload_check": "on",
    "bodyless": "on",
    "multipart_streaming_check": "off",
    "upload_filename_scan_limit": 0,
    "post_body_scan_limit": 2097152,
    "waf_output": "html",
    "waf_redirect_url": "https://www.caddyguard.com"
}

{
	auto_https off

	# caddyguard 全局配置（只写一次，所有站点自动生效）
	caddyguard {
		rule_dir /opt/caddyguard/rule-config
	}

	servers {
		listener_wrappers {
			proxy_protocol {
				allow 127.0.0.0/8
				allow ::1/128
				fallback_policy ignore
			}
			tls
		}
	}

	layer4 {
		:443 {
			# SNI: sub.wyfc.qzz.io -> 127.0.0.1:8443 (caddyguard WAF)
			@sub_wyfc tls sni sub.wyfc.qzz.io
			route @sub_wyfc {
				proxy 127.0.0.1:8443 {
					proxy_protocol v2
				}
			}
			# fallback -> 127.0.0.1:18443 (corefusion 其它业务)
			route {
				proxy 127.0.0.1:18443 {
					proxy_protocol v2
				}
			}
		}
	}
}

# sub.wyfc.qzz.io - HTTPS (caddyguard 全局自动生效，无需站点级配置)
sub.wyfc.qzz.io:8443 {
	tls /opt/corefusion/data/certs/gg/cert.pem /opt/corefusion/data/certs/gg/key.pem

	log {
		output stdout
		format json
	}

	reverse_proxy {
		to 127.0.0.1:8081
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

{
	auto_https off

	# caddyguard 全局配置（只写一次，所有站点自动生效）
	caddyguard {
		rule_dir /opt/caddyguard/rule-config
	}

	servers {
		listener_wrappers {
			proxy_protocol {
				allow 127.0.0.0/8
				allow ::1/128
				fallback_policy ignore
			}
			tls
		}
	}

	layer4 {
		:443 {
			# SNI: sub.wyfc.qzz.io -> 127.0.0.1:8443 (caddyguard WAF)
			@sub_wyfc tls sni sub.wyfc.qzz.io
			route @sub_wyfc {
				proxy 127.0.0.1:8443 {
					proxy_protocol v2
				}
			}
			# fallback -> 127.0.0.1:18443 (corefusion 其它业务)
			route {
				proxy 127.0.0.1:18443 {
					proxy_protocol v2
				}
			}
		}
	}
}

# sub.wyfc.qzz.io - HTTPS
# 全局 WAF 自动生效，无需站点级 caddyguard 指令
sub.wyfc.qzz.io:8443 {
	tls /opt/corefusion/data/certs/gg/cert.pem /opt/corefusion/data/certs/gg/key.pem

	log {
		output stdout
		format json
	}

	# 使用 Caddy 原生 path matcher，路径只声明一次
	@webhook path /api/webhook /api/webhook/*
	route @webhook {
		caddyguard waf_enable off
		reverse_proxy {
			to 127.0.0.1:8081
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	@upload path /upload /upload/*
	route @upload {
		caddyguard waf_enable off
		reverse_proxy {
			to 127.0.0.1:8081
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	reverse_proxy {
		to 127.0.0.1:8081
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}

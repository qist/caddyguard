{
	auto_https off

	# caddyguard 全局配置（只写一次，所有站点自动生效）
	caddyguard {
		rule_dir /opt/caddyguard/rule-config
	}

	servers {
		listener_wrappers {
			proxy_protocol {
				allow 192.168.0.0/16
				allow 172.16.0.0/12
				allow 127.0.0.0/8
				allow ::1/128
				fallback_policy ignore
			}
			tls
		}
	}

	layer4 {
		:443 {
			@waf tls sni waf.wyfc.qzz.io
			route @waf {
				proxy 127.0.0.1:8443 {
					proxy_protocol v2
				}
			}
			route {
				proxy 127.0.0.1:8443 {
					proxy_protocol v2
				}
			}
		}
	}
}

# 站点：无需 caddyguard 配置，全局自动生效
waf.wyfc.qzz.io:8443 {
	tls /opt/caddyguard/certs/cert.pem /opt/caddyguard/certs/key.pem

	log {
		output stdout
		format json
	}

	reverse_proxy 192.168.0.151:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-For {remote_host}
		header_up X-Forwarded-Proto {scheme}
	}
}
